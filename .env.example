# ── Supabase ─────────────────────────────────────────
# 대시보드 > Project Settings > API Keys (신규 키 체계: publishable / secret)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# 서버 전용. 절대 NEXT_PUBLIC_ 붙이지 말 것
SUPABASE_SECRET_KEY=sb_secret_xxx


# ── 미디어 스토리지 (docs/storage-decision.md) ─────────
# local(public 폴더, 목업용) | supabase | r2
NEXT_PUBLIC_STORAGE_DRIVER=local
# r2 사용 시 공개 도메인 (예: https://media.example.com)
NEXT_PUBLIC_MEDIA_BASE_URL=
# r2 사용 시 (서버 전용)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=aoull-media

# ── 분석 ─────────────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ── 사이트 ───────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3100
